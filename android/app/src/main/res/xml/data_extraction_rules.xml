<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep app data out of cloud backup and device-to-device
     transfer. The database is encrypted with a key that never leaves this
     device's Keystore, so a restored copy couldn't be opened anyway; the
     app's own Backup & Restore moves a setup between devices. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
