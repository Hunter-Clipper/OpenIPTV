<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Granted only when signed with OpenIPTV's key. -->
    <uses-permission android:name="com.openiptv.app.permission.CAR_VIDEO" />

    <queries>
        <package android:name="com.openiptv.app" />
    </queries>

    <!-- appCategory="game": Android Auto runs games full screen on the car
         display while parked (the route AABrowser uses). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:allowBackup="false">
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".CarVideoActivity"
            android:exported="true"
            android:label="@string/car_label"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="android.intent.category.APP_MAPS" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
